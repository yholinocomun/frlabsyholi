<?xml version="1.0"?>
<robot name="r6bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       PLANTILLA URDF del r6bot
       Generada a partir de las mallas STL subidas en:
         base_link, link_1, link_2, link_3, link_4, link_5
       => 6 links = 5 articulaciones revolutas.

       IMPORTANTE: los valores xyz/rpy de cada <joint> son
       PLACEHOLDERS (apilados sobre el eje Z). Ajustalos con las
       mediciones reales de tu imagen de referencia. Cada offset
       indica la posicion del eje de la articulacion respecto al
       link padre.
       ============================================================ -->

  <xacro:property name="pi" value="3.14159265359"/>

  <!-- macro auxiliar para crear links desde mallas -->
  <xacro:include filename="$(find r6bot_description)/urdf/create_link.xacro"/>

  <!-- marco fijo del mundo -->
  <link name="world"/>

  <!-- ===================== LINKS ===================== -->
  <xacro:create_link link_name="base_link" mesh_package="r6bot_description" mesh_name="base_link"/>
  <xacro:create_link link_name="link_1"    mesh_package="r6bot_description" mesh_name="link_1"/>
  <xacro:create_link link_name="link_2"    mesh_package="r6bot_description" mesh_name="link_2"/>
  <xacro:create_link link_name="link_3"    mesh_package="r6bot_description" mesh_name="link_3"/>
  <xacro:create_link link_name="link_4"    mesh_package="r6bot_description" mesh_name="link_4"/>
  <xacro:create_link link_name="link_5"    mesh_package="r6bot_description" mesh_name="link_5"/>

  <!-- marco de la herramienta / efector final -->
  <link name="tool0"/>

  <!-- ===================== JOINTS ===================== -->

  <!-- fija la base al mundo -->
  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- joint_1: base_link -> link_1   (AJUSTAR offset con la imagen) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <!-- joint_2: link_1 -> link_2 -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.15" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <!-- joint_3: link_2 -> link_3 -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <!-- joint_4: link_3 -> link_4 -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.30 0 0" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <!-- joint_5: link_4 -> link_5 -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.15" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <!-- herramienta fija al ultimo link -->
  <joint name="joint_tool" type="fixed">
    <parent link="link_5"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

</robot>
